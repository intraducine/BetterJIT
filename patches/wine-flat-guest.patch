@@ -1885 +1935,2 @@ static void start_main_thread(void)
-    init_thread_stack( teb, 0, 0, 0 );
+    if (init_thread_stack( teb, 0, 0, 0 ))
+        fatal_error( "BetterJIT Wine: could not allocate the initial thread stacks\n" );
diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index 36ffe20..51be0be 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -438,0 +439,16 @@ static NTSTATUS spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int so
+    if (getenv( "BETTERJIT_WINE_SPAWN" ) && !strcmp( getenv( "BETTERJIT_WINE_SPAWN" ), "1" ))
+    {
+        BOOL detached = (peb->ProcessParameters && params->ProcessGroupId != peb->ProcessParameters->ProcessGroupId) ||
+                        params->ConsoleHandle == CONSOLE_HANDLE_ALLOC ||
+                        params->ConsoleHandle == CONSOLE_HANDLE_ALLOC_NO_WINDOW || params->ConsoleHandle == NULL;
+        if (!(argv = build_argv( &params->CommandLine, 2 ))) status = STATUS_NO_MEMORY;
+        else
+        {
+            status = spawn_wineloader( argv, socketfd, pe_info, unixdir, stdin_fd, stdout_fd, detached, winedebug );
+            free( argv );
+        }
+        if (stdin_fd != -1 && stdin_fd != 0) close( stdin_fd );
+        if (stdout_fd != -1 && stdout_fd != 1) close( stdout_fd );
+        return status;
+    }
+
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index 3c9b3e9..9175b92 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -400,0 +401,16 @@ C_ASSERT( sizeof(struct callback_stack_layout) == 0x58 );
+/* The flat guest candidate supports Win64 only. A null FS selector is
+ * implemented by Linux ARCH_SET_FS(0), including its base-clearing effect.
+ * Non-null selectors need a descriptor/32-bit execution model and trap here.
+ * Preserve registers/flags without overwriting the active Wine frame or red zone.
+ * The bottom reserved kernel-stack area supplies scratch space; Win64 signal
+ * paths do not recursively load WoW64 FS selectors.
+ */
+#define BETTERJIT_LOAD_NULL_FS(operand) \
+    "movq %rsp,%gs:0x350\n\tmovq %gs:0x370,%rsp\n\tleaq 0x1000(%rsp),%rsp\n\t" \
+    "pushfq\n\tpushq %rax\n\tpushq %rdi\n\tpushq %rsi\n\tpushq %rcx\n\tpushq %r11\n\t" \
+    "cmpw $0," operand "\n\tjne 99f\n\t" \
+    "xorl %esi,%esi\n\tmovl $0x1002,%edi\n\tmovl $158,%eax\n\tsyscall\n\t" \
+    "testq %rax,%rax\n\tjne 99f\n\tjmp 98f\n" \
+    "99:\tud2\n" \
+    "98:\tpopq %r11\n\tpopq %rcx\n\tpopq %rsi\n\tpopq %rdi\n\tpopq %rax\n\tpopfq\n\tmovq %gs:0x350,%rsp\n\t"
+
@@ -457,0 +474 @@ struct amd64_thread_data
+    void                 *flat_fs_saved_rsp;         /* 0350: flat candidate scratch */
@@ -459,0 +477,2 @@ struct amd64_thread_data
+C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct amd64_thread_data, flat_fs_saved_rsp ) == 0x350 );
+C_ASSERT( offsetof( TEB, GdiTebBatch ) + offsetof( struct ntdll_thread_data, kernel_stack ) == 0x370 );
@@ -872 +891 @@ static inline void leave_handler( ucontext_t *sigcontext )
-        __asm__ volatile( "movw %0,%%fs" :: "r" (fs32_sel) );
+        raise( SIGILL ); /* Non-null FS selectors are unsupported in this Win64 candidate. */
@@ -1653 +1672 @@ __ASM_GLOBAL_FUNC( call_user_mode_callback,
-                   "movw 0x338(%r8),%fs\n"     /* amd64_thread_data()->fs */
+                   BETTERJIT_LOAD_NULL_FS("0x338(%r8)")     /* amd64_thread_data()->fs */
@@ -2867 +2886 @@ __ASM_GLOBAL_FUNC( __wine_syscall_dispatcher,
-                   "movw %gs:0x338,%fs\n"          /* amd64_thread_data()->fs */
+                   BETTERJIT_LOAD_NULL_FS("%gs:0x338")          /* amd64_thread_data()->fs */
@@ -3101 +3120 @@ __ASM_GLOBAL_FUNC( __wine_unix_call_dispatcher,
-                   "movw %gs:0x338,%fs\n"          /* amd64_thread_data()->fs */
+                   BETTERJIT_LOAD_NULL_FS("%gs:0x338")          /* amd64_thread_data()->fs */
