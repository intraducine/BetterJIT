diff --git a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
index 512defa..88c5c78 100644
--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -33,0 +34,3 @@
+#ifdef __linux__
+#include "betterjit_spawn.h"
+#endif
@@ -542,0 +546,47 @@ NTSTATUS exec_wineloader( char **argv, int socketfd, const struct pe_image_info
+/* Only the adapted Win64 candidate opts into this path. Environment and argv
+ * are prepared without mutating the parent, and libc supplies a vfork-safe
+ * launch implementation with explicit actions instead of Wine's double fork. */
+NTSTATUS spawn_wineloader( char **argv, int socketfd, const struct pe_image_info *pe_info,
+                          int unixdir, int input, int output, BOOL detached, char *winedebug )
+{
+#ifdef __linux__
+    WORD machine = pe_info->machine;
+    ULONGLONG start = pe_info->base, end = start + pe_info->map_size;
+    char reserve[64], socket[64], **envp, *alternate;
+    size_t count = 0, n = 0, i;
+    pid_t pid = -1;
+    int ret;
+    if (pe_info->wine_fakedll) start = end = 0;
+    if (pe_info->image_flags & IMAGE_FLAGS_ComPlusNativeReady) machine = native_machine;
+    snprintf( socket, sizeof(socket), "WINESERVERSOCKET=%u", socketfd );
+    snprintf( reserve, sizeof(reserve), "WINEPRELOADRESERVE=%x%08x-%x%08x",
+              (UINT)(start >> 32), (UINT)start, (UINT)(end >> 32), (UINT)end );
+    while (environ[count]) count++;
+    if (!(envp = malloc( (count + 5) * sizeof(*envp) ))) return STATUS_NO_MEMORY;
+    for (i = 0; i < count; i++)
+    {
+        if (!strncmp( environ[i], "WINESERVERSOCKET=", sizeof("WINESERVERSOCKET=") - 1 ) ||
+            !strncmp( environ[i], "WINEPRELOADRESERVE=", sizeof("WINEPRELOADRESERVE=") - 1 ) ||
+            !strncmp( environ[i], "WINELOADERNOEXEC=", sizeof("WINELOADERNOEXEC=") - 1 ) ||
+            (winedebug && !strncmp( environ[i], "WINEDEBUG=", sizeof("WINEDEBUG=") - 1 ))) continue;
+        envp[n++] = environ[i];
+    }
+    envp[n++] = socket;envp[n++] = reserve;envp[n++] = "WINELOADERNOEXEC=1";
+    if (winedebug) envp[n++] = winedebug;
+    envp[n] = NULL;
+    alternate = get_alternate_wineloader( machine );
+    argv[1] = alternate ? alternate : wineloader;
+    ret = betterjit_spawn( &pid, argv[1], argv + 1, envp, socketfd, unixdir, input, output, detached );
+    if (ret && alternate && pid == -1)
+    {
+        argv[1] = wineloader;
+        ret = betterjit_spawn( &pid, argv[1], argv + 1, envp, socketfd, unixdir, input, output, detached );
+    }
+    free( alternate );free( envp );
+    return ret ? errno_to_status( ret ) : STATUS_SUCCESS;
+#else
+    return STATUS_NOT_SUPPORTED;
+#endif
+}
+
