diff --git a/dlls/ntdll/unix/betterjit_spawn.h b/dlls/ntdll/unix/betterjit_spawn.h
new file mode 100644
index 0000000..e506867
--- /dev/null
+++ b/dlls/ntdll/unix/betterjit_spawn.h
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Candidate-only process launch. All setup occurs in the parent and in
+ * libc's posix_spawn file actions; generic fork semantics are unchanged.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <signal.h>
+#include <spawn.h>
+#include <stdlib.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static void *betterjit_reap_spawn( void *arg )
+{
+    pid_t pid = *(pid_t *)arg;
+    free( arg );
+    while (waitpid( pid, NULL, 0 ) == -1 && errno == EINTR) {}
+    return NULL;
+}
+
+/* Returns a POSIX error number. Success owns and reaps this exact child,
+ * never stealing another waiter's child. Parent fds/cwd/signals are untouched.
+ */
+static int betterjit_spawn( pid_t *pid, const char *loader, char *const argv[], char *const envp[],
+                           int socketfd, int unixdir, int input, int output, int detached )
+{
+    posix_spawn_file_actions_t actions;
+    posix_spawnattr_t attr;
+    pthread_attr_t thread_attr;
+    pthread_t thread;
+    sigset_t defaults;
+    short flags = POSIX_SPAWN_SETSIGDEF;
+    int ret, i, j, close_fds[3] = {input, output, unixdir};
+    pid_t *owned;
+
+    if (!pid || !loader || !argv || !envp || socketfd < -1 || unixdir < -1 || input < -1 || output < -1)
+        return EINVAL;
+    *pid = -1;
+    if (!(owned = malloc( sizeof(*owned) ))) return ENOMEM;
+    if ((ret = posix_spawn_file_actions_init( &actions ))) goto free_owned;
+    if ((ret = posix_spawnattr_init( &attr ))) goto destroy_actions;
+    if ((ret = pthread_attr_init( &thread_attr ))) goto destroy_attr;
+    if ((ret = pthread_attr_setdetachstate( &thread_attr, PTHREAD_CREATE_DETACHED ))) goto destroy_thread_attr;
+    if (detached) flags |= POSIX_SPAWN_SETSID;
+    sigemptyset( &defaults );
+    sigaddset( &defaults, SIGPIPE );
+    if ((ret = posix_spawnattr_setsigdefault( &attr, &defaults )) ||
+        (ret = posix_spawnattr_setflags( &attr, flags ))) goto destroy_thread_attr;
+    if (unixdir != -1 && (ret = posix_spawn_file_actions_addfchdir_np( &actions, unixdir ))) goto destroy_thread_attr;
+    if (detached || input == -1) ret = posix_spawn_file_actions_addopen( &actions, 0, "/dev/null", O_RDWR, 0 );
+    else ret = posix_spawn_file_actions_adddup2( &actions, input, 0 );
+    if (ret) goto destroy_thread_attr;
+    if (detached || output == -1) ret = posix_spawn_file_actions_addopen( &actions, 1, "/dev/null", O_RDWR, 0 );
+    else ret = posix_spawn_file_actions_adddup2( &actions, output, 1 );
+    if (ret) goto destroy_thread_attr;
+    for (i = 0; i < 3; i++)
+    {
+        if (close_fds[i] <= 1 || close_fds[i] == socketfd) continue;
+        for (j = 0; j < i; j++) if (close_fds[j] == close_fds[i]) break;
+        if (j < i) continue;
+        if ((ret = posix_spawn_file_actions_addclose( &actions, close_fds[i] ))) goto destroy_thread_attr;
+    }
+    /* A dup2 action on the same descriptor makes it inheritable across exec. */
+    if (socketfd != -1 && (ret = posix_spawn_file_actions_adddup2( &actions, socketfd, socketfd )))
+        goto destroy_thread_attr;
+    if ((ret = posix_spawn( pid, loader, &actions, &attr, argv, envp ))) goto destroy_thread_attr;
+    *owned = *pid;
+    if (!(ret = pthread_create( &thread, &thread_attr, betterjit_reap_spawn, owned ))) owned = NULL;
+    else
+    {
+        /* A successful launch must not escape ownership if reaping cannot start. */
+        kill( *pid, SIGKILL );
+        while (waitpid( *pid, NULL, 0 ) == -1 && errno == EINTR) {}
+    }
+destroy_thread_attr:
+    pthread_attr_destroy( &thread_attr );
+destroy_attr:
+    posix_spawnattr_destroy( &attr );
+destroy_actions:
+    posix_spawn_file_actions_destroy( &actions );
+free_owned:
+    free( owned );
+    return ret;
+}
